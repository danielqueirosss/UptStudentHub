<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l">
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_l"
        android:text="@string/welcome_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="name"
        android:hint="@string/hint_student_name"
        android:inputType="textPersonName|textCapWords"
        android:minHeight="@dimen/touch_target" />
    <Button
        android:id="@+id/btnOpenTimetable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:minHeight="@dimen/touch_target"
        android:text="@string/btn_open_timetable" />
    <!-- Week 7: second entry point, opens the network screen -->
    <Button
        android:id="@+id/btnOpenWeather"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:minHeight="@dimen/touch_target"
        android:text="@string/btn_open_weather" />
</LinearLayout>